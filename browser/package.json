{
  "name": "@bergamot/browser-extension",
  "version": "0.1.0",
  "description": "Bergamot Browser Extension - Steeping knowledge from your web browsing patterns",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.ts --bundle --outfile=dist/content.bundle.js --format=iife --allow-overwrite && esbuild src/background.ts --bundle --outfile=dist/background.bundle.js --format=esm --allow-overwrite",
    "postbuild": "node copy-dist-to-browser-folders.js",
    "watch": "esbuild src/content.ts --bundle --outfile=chrome/dist/content.bundle.js --format=iife --allow-overwrite --watch & esbuild src/background.ts --bundle --outfile=chrome/dist/background.bundle.js --format=esm --allow-overwrite --watch",
    "dev:brave": "node scripts/dev-brave.js",
    "build:test": "node build-for-test.js",
    "postbuild:test": "node copy-dist-to-browser-folders.js",
    "build:production": "node scripts/build-production.js",
    "package": "npm run build:production",
    "publish:chrome": "node scripts/publish-chrome.js",
    "publish:edge": "node scripts/publish-edge.js",
    "publish:all": "npm run publish:chrome && npm run publish:edge",
    "version:patch": "node scripts/version-bump.js patch",
    "version:minor": "node scripts/version-bump.js minor",
    "version:major": "node scripts/version-bump.js major",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "HEADED=1 playwright test",
    "test": "npm run test:unit",
    "chrome": "node scripts/load-extension.js",
    "chrome:debug": "node scripts/load-extension.js --auto-open-devtools-for-tabs",
    "debug": "npm run build && npm run chrome:debug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hpcc-js/wasm-zstd": "^1.2.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.260",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.8",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.4.2"
  }
}
