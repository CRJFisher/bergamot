{
  "name": "bergamot",
  "displayName": "Bergamot",
  "description": "Steep knowledge from your browsing patterns in VS Code",
  "version": "0.1.0",
  "publisher": "bergamot",
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "bergamot",
    "knowledge-management",
    "pkm",
    "web-memory",
    "browser-history",
    "note-taking",
    "webpage-capture"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bergamot.showCaptureMetrics",
        "title": "Bergamot: Show Capture Gate Metrics"
      },
      {
        "command": "bergamot.showVisitOutcomes",
        "title": "Bergamot: Show Visit Outcomes"
      },
      {
        "command": "bergamot.replayVisit",
        "title": "Bergamot: Replay Visit"
      }
    ],
    "configuration": {
      "title": "Bergamot",
      "properties": {
        "bergamot.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable dev-phase observability: the Bergamot Dev output channel and a tail-able dev-log.jsonl. Always on during F5 debugging."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "clean": "rm -rf out",
    "package": "vsce package",
    "build:production": "node scripts/build-production.js",
    "version:patch": "node scripts/version-bump.js patch",
    "version:minor": "node scripts/version-bump.js minor",
    "version:major": "node scripts/version-bump.js major",
    "version:prerelease": "node scripts/version-bump.js prerelease",
    "publish:vscode": "node scripts/publish-vscode.js",
    "publish:openvsx": "node scripts/publish-openvsx.js",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.2.2-alpha.18",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@mongodb-js/zstd": "^2.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "20.x",
    "@types/supertest": "^6.0.3",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ovsx": "^0.10.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bergamot/bergamot.git"
  },
  "bugs": {
    "url": "https://github.com/bergamot/bergamot/issues"
  },
  "homepage": "https://github.com/bergamot/bergamot#readme",
  "license": "MIT"
}
