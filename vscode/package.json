{
  "name": "bergamot",
  "displayName": "Bergamot",
  "description": "",
  "version": "0.1.0",
  "publisher": "bergamot",
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "bergamot",
    "knowledge-management",
    "pkm",
    "web-memory",
    "browser-history",
    "note-taking",
    "webpage-capture"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bergamot.showVisitOutcomes",
        "title": "Bergamot: Show Visit Outcomes"
      },
      {
        "command": "bergamot.replayVisit",
        "title": "Bergamot: Replay Visit"
      },
      {
        "command": "bergamot.forget",
        "title": "Bergamot: Forget (delete by URL, origin, or time range)"
      },
      {
        "command": "bergamot.tdt.embedPages",
        "title": "Bergamot: Embed pages for topic detection"
      },
      {
        "command": "bergamot.tdt.rebuildClusters",
        "title": "Bergamot: Detect topic clusters from browsing"
      }
    ],
    "configuration": {
      "title": "Bergamot",
      "properties": {
        "bergamot.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable dev-phase observability: the Bergamot Dev output channel and a tail-able dev-log.jsonl. Always on during F5 debugging."
        },
        "bergamot.staging.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path for the quarantined bergamot.staging/ directory where agent-authored topic-cluster note stubs are written. Empty = a 'bergamot.staging' folder in the first workspace folder. Stubs are drafts you promote by hand; this directory is auto-gitignored and never committed."
        },
        "bergamot.tdt.clusterCadenceHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "description": "How often (in hours) Bergamot automatically detects topic clusters from your browsing. Default once/day. A run over an unchanged window is a no-op, so a daily run costs ~nothing on quiet days. Set to 0 to disable the automatic run (the manual 'Detect topic clusters' command still works)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "clean": "rm -rf out",
    "package": "node scripts/build-production.js",
    "build:production": "node scripts/build-production.js",
    "verify:embedder": "npm run compile && node scripts/verify-embedder.mjs",
    "version:patch": "node scripts/version-bump.js patch",
    "version:minor": "node scripts/version-bump.js minor",
    "version:major": "node scripts/version-bump.js major",
    "version:prerelease": "node scripts/version-bump.js prerelease",
    "publish:vscode": "node scripts/publish-vscode.js",
    "publish:openvsx": "node scripts/publish-openvsx.js",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx"
  },
  "dependencies": {
    "@bergamot/tdt": "*",
    "@duckdb/node-api": "^1.5.3-r.3",
    "@huggingface/transformers": "3.7.6",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@tensorflow/tfjs-node": "^4.20.0",
    "cors": "^2.8.5",
    "defuddle": "^0.18.1",
    "express": "^5.1.0",
    "linkedom": "^0.18.12",
    "patchright": "^1.60.2",
    "tldts": "6.1.86",
    "turndown": "^7.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "20.x",
    "@types/supertest": "^6.0.3",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ovsx": "^0.10.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bergamot/bergamot.git"
  },
  "bugs": {
    "url": "https://github.com/bergamot/bergamot/issues"
  },
  "homepage": "https://github.com/bergamot/bergamot#readme",
  "license": "MIT"
}
