{
  "name": "bergamot",
  "displayName": "Bergamot",
  "description": "Steep knowledge from your browsing patterns in VS Code",
  "version": "0.1.0",
  "publisher": "bergamot",
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "bergamot",
    "knowledge-management",
    "pkm",
    "web-memory",
    "browser-history",
    "note-taking",
    "webpage-capture"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bergamot.searchWebpages",
        "title": "Bergamot: Search Webpages"
      },
      {
        "command": "bergamot.showFilterMetrics",
        "title": "Bergamot: Show Filter Metrics"
      },
      {
        "command": "bergamot.showVisitOutcomes",
        "title": "Bergamot: Show Visit Outcomes"
      },
      {
        "command": "bergamot.replayVisit",
        "title": "Bergamot: Replay Visit"
      }
    ],
    "configuration": {
      "title": "Bergamot",
      "properties": {
        "bergamot.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "Your OpenAI API key for Bergamot (only needed when llmProvider is 'openai')",
          "scope": "application"
        },
        "bergamot.llmProvider": {
          "type": "string",
          "enum": [
            "claude",
            "openai",
            "vscode"
          ],
          "default": "claude",
          "description": "Backend for classification and analysis: 'claude' (subscription, no API tokens), 'openai' (uses openaiApiKey), or 'vscode' (editor language model)."
        },
        "bergamot.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable dev-phase observability: the Bergamot Dev output channel and a tail-able dev-log.jsonl. Always on during F5 debugging."
        },
        "bergamot.webpageFilter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable webpage filtering based on content type"
        },
        "bergamot.webpageFilter.allowedTypes": {
          "type": "array",
          "default": [
            "knowledge"
          ],
          "description": "Types of pages to process",
          "items": {
            "type": "string",
            "enum": [
              "knowledge",
              "interactive_app",
              "aggregator",
              "leisure",
              "navigation",
              "other"
            ]
          }
        },
        "bergamot.webpageFilter.minConfidence": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence threshold for page classification"
        },
        "bergamot.webpageFilter.logDecisions": {
          "type": "boolean",
          "default": true,
          "description": "Log filtering decisions to console"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "clean": "rm -rf out",
    "package": "vsce package",
    "build:production": "node scripts/build-production.js",
    "version:patch": "node scripts/version-bump.js patch",
    "version:minor": "node scripts/version-bump.js minor",
    "version:major": "node scripts/version-bump.js major",
    "version:prerelease": "node scripts/version-bump.js prerelease",
    "publish:vscode": "node scripts/publish-vscode.js",
    "publish:openvsx": "node scripts/publish-openvsx.js",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.2.2-alpha.18",
    "@lancedb/lancedb": "^0.19.0",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@mongodb-js/zstd": "^2.0.1",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "openai": "^6.41.0",
    "uuid": "^11.1.0",
    "xstate": "^5.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "20.x",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ovsx": "^0.10.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bergamot/bergamot.git"
  },
  "bugs": {
    "url": "https://github.com/bergamot/bergamot/issues"
  },
  "homepage": "https://github.com/bergamot/bergamot#readme",
  "license": "MIT"
}
